# O sistema inicia em dry-run. Nunca comite o arquivo .env.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=
META_ACCESS_TOKEN=
# Chave privada de no mínimo 32 caracteres para autorizar chamadas à API publicada.
PUBLISHER_API_KEY=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_LOGIN_MODE=instagram
INSTAGRAM_POLL_INTERVAL_MS=60000
INSTAGRAM_POLL_ATTEMPTS=5
IDEMPOTENCY_DIRECTORY=.state/instagram-idempotency
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_APPROVER_CHAT_ID=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_MEDIA_BASE_URL=
STORAGE_BUCKET=
APP_ENV=dry-run
ENABLE_REAL_PUBLISHING=false
APPROVAL_REQUIRED=true
MAX_AUTOMATIC_REVISIONS=2
PORT=3000
CHROMIUM_EXECUTABLE_PATH=

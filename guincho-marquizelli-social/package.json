{
  "name": "guincho-marquizelli-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP seguro para produção, aprovação e publicação de conteúdo social da Guincho Marquizelli.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/src/api/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "lint": "tsc -p tsconfig.json --noEmit",
    "render": "tsx src/cli.ts render",
    "workflow:dry-run": "tsx src/cli.ts workflow:dry-run",
    "telegram:dev": "tsx src/cli.ts telegram:dev",
    "publish:dry-run": "tsx src/cli.ts publish:dry-run",
    "instagram:verify": "tsx src/cli.ts instagram:verify",
    "seed": "tsx src/cli.ts seed",
    "brand:validate": "tsx src/cli.ts brand:validate",
    "assets:inventory": "tsx src/cli.ts assets:inventory"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "playwright-core": "1.62.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
